FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN python -m pip install -r requirements.txt

COPY src ./src
COPY PROJECT_SETUP_ARCHITECTURE.md .
COPY README.md .

RUN adduser --disabled-password --gecos "" appuser \
    && mkdir -p /app/data && chown appuser:appuser /app/data
USER appuser

EXPOSE 8000

# Keep the REST API single-process: each worker would create its own IBKR
# session, in-process cache, and streaming state.
CMD ["uvicorn", "src.webapp.app:get_app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--factory", \
     "--loop", "asyncio", \
     "--lifespan", "on"]
