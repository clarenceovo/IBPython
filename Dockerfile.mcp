# syntax=docker/dockerfile:1
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked python -m pip install --no-compile -r requirements.txt

COPY src ./src

RUN adduser --disabled-password --gecos "" appuser
USER appuser

EXPOSE 9000

# MCP streamable HTTP transport — binds 0.0.0.0:9000 inside container.
# Auth is handled by MCPBearerAuthMiddleware when MCP_API_KEY is set.
CMD ["python", "-m", "src.mcp_server", "--http"]
